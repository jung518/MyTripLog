# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. (.env.local 은 GitHub에 올라가지 않음)
# 비워 두면 로컬 모드(이 브라우저의 IndexedDB에만 저장)로 동작합니다.

# Supabase 대시보드 → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# publishable(anon) 키만 넣으세요. service_role / secret 키는 절대 넣지 마세요.
VITE_SUPABASE_KEY=your-publishable-anon-key
